<h2 id=3D"Notifications&amp;Alert-1.M=C3=B4t=E1=BA=A3">1. M=C3=B4 t=E1=BA=
=A3</h2>
<p>Sport Notification l=C3=A0 t=C3=ADnh n=C4=83ng g=E1=BB=ADi c=E1=BA=ADp n=
h=E1=BA=ADt tr=E1=BA=ADn =C4=91=E1=BA=A5u b=C3=B3ng =C4=91=C3=A1 =C4=91=E1=
=BA=BFn user =C4=91=C3=A3 th=E1=BB=B1c hi=E1=BB=87n m=E1=BB=99t trong c=C3=
=A1c h=C3=A0nh =C4=91=E1=BB=99ng:</p>
<ul>
<li><strong>=C4=90=E1=BA=B7t L=E1=BB=8Bch</strong><span>&nbsp;</span>(conte=
nt_event_match): follow tr=E1=BB=B1c ti=E1=BA=BFp 1 tr=E1=BA=ADn c=E1=BB=A5=
 th=E1=BB=83.</li>
<li><strong>Theo d=C3=B5i =C4=90=E1=BB=99i b=C3=B3ng</strong><span>&nbsp;</=
span>(sport_team): follow =C4=91=E1=BB=99i b=C3=B3ng; h=E1=BB=87 th=E1=BB=
=91ng t=E1=BB=B1 =C4=91=E1=BB=99ng l=E1=BA=A5y t=E1=BA=A5t c=E1=BA=A3 tr=E1=
=BA=ADn =C4=91ang live c=E1=BB=A7a =C4=91=E1=BB=99i =C4=91=C3=B3.</li>
<li><strong>Theo d=C3=B5i M=C3=B9a gi=E1=BA=A3i</strong><span>&nbsp;</span>=
(sport_league): follow m=C3=B9a gi=E1=BA=A3i; h=E1=BB=87 th=E1=BB=91ng t=E1=
=BB=B1 =C4=91=E1=BB=99ng l=E1=BA=A5y t=E1=BA=A5t c=E1=BA=A3 tr=E1=BA=ADn =
=C4=91ang live trong m=C3=B9a gi=E1=BA=A3i =C4=91=C3=B3.</li>
</ul>
<p>Notification =C4=91=C6=B0=E1=BB=A3c g=E1=BB=ADi th=C3=B4ng qua OS Push N=
otification v=C3=A0 c=C3=B3 th=E1=BB=83 xu=E1=BA=A5t hi=E1=BB=87n d=C6=B0=
=E1=BB=9Bi c=C3=A1c presentation surface do h=E1=BB=87 =C4=91i=E1=BB=81u h=
=C3=A0nh h=E1=BB=97 tr=E1=BB=A3, bao g=E1=BB=93m:</p>
<ul>
<li>Lock Screen;</li>
<li>banner ho=E1=BA=B7c heads-up notification;</li>
<li>OS Notification Center;</li>
</ul>
<p>Sport Notification h=E1=BB=97 tr=E1=BB=A3 hai nh=C3=B3m n=E1=BB=99i dung=
 ch=C3=ADnh:</p>
<ol>
<li><strong>Match Status Notification</strong><br>Th=E1=BB=83 hi=E1=BB=87n =
tr=E1=BA=A1ng th=C3=A1i ho=E1=BA=B7c giai =C4=91o=E1=BA=A1n hi=E1=BB=87n t=
=E1=BA=A1i c=E1=BB=A7a tr=E1=BA=ADn =C4=91=E1=BA=A5u, bao g=E1=BB=93m remin=
der, b=E1=BA=AFt =C4=91=E1=BA=A7u tr=E1=BA=ADn, ngh=E1=BB=89 gi=E1=BB=AFa h=
i=E1=BB=87p, hi=E1=BB=87p hai, hi=E1=BB=87p ph=E1=BB=A5, lu=C3=A2n l=C6=B0u=
 v=C3=A0 k=E1=BA=BFt th=C3=BAc tr=E1=BA=ADn.</li>
<li><strong>Match Event Notification</strong><br>Th=E1=BB=83 hi=E1=BB=87n d=
i=E1=BB=85n bi=E1=BA=BFn c=E1=BB=A5 th=E1=BB=83 trong tr=E1=BA=ADn, bao g=
=E1=BB=93m b=C3=A0n th=E1=BA=AFng, penalty, th=E1=BA=BB ph=E1=BA=A1t, VAR, =
lu=C3=A2n l=C6=B0u v=C3=A0 thay ng=C6=B0=E1=BB=9Di.</li>
</ol>
<p>Khi nh=E1=BA=ADn Match Status/ Match Event, h=E1=BB=87 th=E1=BB=91ng s=
=E1=BA=BD th=E1=BB=B1c hi=E1=BB=87n <strong>override</strong> notification =
hi=E1=BB=87n t=E1=BA=A1i c=E1=BB=A7a app =C4=91=E1=BB=83 hi=E1=BB=83n th=E1=
=BB=8B Sport Notification.</p>
