<p>Rules</p>
<ul>
<li>User ph=E1=BA=A3i =C4=91=C4=83ng nh=E1=BA=ADp tr=C6=B0=E1=BB=9Bc khi su=
bscription =C4=91=C6=B0=E1=BB=A3c l=C6=B0u.</li>
<li>Match, team ho=E1=BA=B7c league ph=E1=BA=A3i c=C3=B2n h=E1=BB=A3p l=E1=
=BB=87 v=C3=A0 =C4=91=E1=BB=A7 =C4=91i=E1=BB=81u ki=E1=BB=87n subscribe.</l=
i>
<li>M=E1=BB=99t match c=C3=B3 th=E1=BB=83 =C4=91=C6=B0=E1=BB=A3c x=C3=A1c =
=C4=91=E1=BB=8Bnh t=E1=BB=AB nhi=E1=BB=81u subscription source.</li>
<li>H=E1=BB=87 th=E1=BB=91ng l=C6=B0u t=E1=BB=ABng subscription source =C4=
=91=E1=BB=99c l=E1=BA=ADp.</li>
<li>C=C3=A1c match =C4=91=C6=B0=E1=BB=A3c x=C3=A1c =C4=91=E1=BB=8Bnh t=E1=
=BB=AB nhi=E1=BB=81u source ph=E1=BA=A3i =C4=91=C6=B0=E1=BB=A3c lo=E1=BA=A1=
i b=E1=BB=8F tr=C3=B9ng l=E1=BA=B7p&nbsp;theo <code>match_id</code>.</li>
<li>Khi user h=E1=BB=A7y =C4=91=C4=83ng k=C3=BD (<em>unsubscribe</em>) m=E1=
=BB=99t ngu=E1=BB=93n (<em>source</em>), h=E1=BB=87 th=E1=BB=91ng ph=E1=BA=
=A3i =C4=91=C3=A1nh gi=C3=A1 l=E1=BA=A1i (<em>re-evaluate</em>) to=C3=A0n b=
=E1=BB=99 ngu=E1=BB=93n c=C3=B2n l=E1=BA=A1i tr=C6=B0=E1=BB=9Bc khi k=E1=BA=
=BFt th=C3=BAc notification.
<ul>
<li>N=E1=BA=BFu tr=E1=BA=ADn =C4=91=E1=BA=A5u hi=E1=BB=87n t=E1=BA=A1i (<em=
>current match</em>) v=E1=BA=ABn =C4=91=C6=B0=E1=BB=A3c x=C3=A1c =C4=91=E1=
=BB=8Bnh t=E1=BB=AB =C3=ADt nh=E1=BA=A5t m=E1=BB=99t ngu=E1=BB=93n h=E1=BB=
=A3p l=E1=BB=87, notification c=E1=BB=A7a match =C4=91=C3=B3 ti=E1=BA=BFp t=
=E1=BB=A5c ho=E1=BA=A1t =C4=91=E1=BB=99ng.</li>
<li>N=E1=BA=BFu tr=E1=BA=ADn =C4=91=E1=BA=A5u hi=E1=BB=87n t=E1=BA=A1i (<em=
>current match</em>) kh=C3=B4ng c=C3=B2n ngu=E1=BB=93n n=C3=A0o h=E1=BB=A3p=
 l=E1=BB=87, notification c=E1=BB=A7a match =C4=91=C3=B3 s=E1=BA=BD k=E1=BA=
=BFt th=C3=BAc.</li>
</ul></li>
<li>Tr=E1=BA=A1ng th=C3=A1i =C4=90=E1=BA=B7t l=E1=BB=8Bch (update Sprint 28=
):
<ul>
<li>Tr=E1=BA=ADn =C4=91=E1=BA=A5u ch=C6=B0a di=E1=BB=85n ra (Ch=C6=B0a =C4=
=91=E1=BA=BFn gi=E1=BB=9D Live): Cho ph=C3=A9p b=E1=BA=A5m =C4=90=E1=BA=B7t=
 L=E1=BB=8Bch <span class=3D"math-inline">-&gt;</span> H=E1=BB=87 th=E1=BB=
=91ng l=C6=B0u tr=E1=BA=A1ng th=C3=A1i theo d=C3=B5i nh=C6=B0ng kh=C3=B4ng =
k=C3=ADch ho=E1=BA=A1t Live Activity ngo=C3=A0i =E1=BB=A9ng d=E1=BB=A5ng.</=
li>
